{
    "Version": "2012-10-17",
    "Id": "example-ID",
    "Statement": [
        {
            "Sid": "Example SNS topic policy",
            "Effect": "Allow",
            "Principal": {
                "Service": "s3.amazonaws.com"
            },
            "Action": [
                "SNS:Publish"
            ],
            "Resource": "arn:aws:sns:eu-west-2:367573295024:RafalsEmail",
            "Condition": {
                "ArnLike": {
                    "aws:SourceArn": "arn:aws:s3:::rafal-s3-encryption"
                },
                "StringEquals": {
                    "aws:SourceAccount": "367573295024"
                }
            }
        }
    ]
}  